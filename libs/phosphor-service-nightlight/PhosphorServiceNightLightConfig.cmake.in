@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Mirror the PUBLIC link set in CMakeLists.txt. (Qt6::Gui and libwayland-client
# are PRIVATE links: the gamma-control client lives inside the .cpp files and no
# Wayland type appears in a public header.)
find_dependency(Qt6 @PHOSPHORSERVICENIGHTLIGHT_QT_MIN@ COMPONENTS Core Qml)

include("${CMAKE_CURRENT_LIST_DIR}/PhosphorServiceNightLightTargets.cmake")

check_required_components(PhosphorServiceNightLight)
